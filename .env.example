# Provider endpoint supporting /chat/completions (with tools), /embeddings and /rerank.
MODEL_BASE_URL=https://YOUR_PROVIDER/v1
MODEL_API_KEY=replace-me
CHAT_MODEL=your-tool-capable-model
CHAT_MAX_TOKENS=4096
# Jev Decisions API selects tools; CHAT_MODEL generates arguments, SQL and prose.
# Leave ROUTER_MODEL empty to use chat-based routing.
ROUTER_MODEL=typesafe/jev-1.14
ROUTER_BASE_URL=https://openrouter.ai/api/alpha
# Only a pair of documents_agent + database_agent runs concurrently.
PARALLEL_RETRIEVAL=true
EMBEDDING_MODEL=your-multilingual-embedding-model
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=8
RERANK_TOP_K=3
# Dedicated rerank model served by MODEL_BASE_URL (OpenRouter).
RERANK_MODEL=qwen/qwen3-reranker-8b
RERANK_MIN_SCORE=0.1
# Local execution; Docker Compose uses http://milvus:19530 automatically.
MILVUS_URI=http://localhost:19530

# Bounded PDF extraction. OCR uses bundled fast Persian+English data in memory.
PDF_MAX_MB=20
PDF_MAX_PAGES=100
PDF_MAX_OCR_PAGES=20
PDF_OCR_DPI=200
# Enable only for files with a broken native text layer; OCR may be less accurate.
PDF_FORCE_OCR=false

# Optional remote tracing. Question, answers and evidence are sent when enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adan-banking
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# INFO: lifecycle, routes, tool results and errors. DEBUG adds per-stage timing.
LOG_LEVEL=INFO

# Optional Decisions API evaluator settings; defaults to MODEL_API_KEY / ROUTER_BASE_URL.
EVAL_MODEL=~typesafe/jev-latest
# EVAL_BASE_URL=https://openrouter.ai/api/alpha
# EVAL_API_KEY=
